{
  "name": "@loomwiki/worker",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.dev.jsonc --port 8788",
    "build": "wrangler deploy --dry-run --outdir dist --config ../../wrangler.jsonc",
    "deploy": "wrangler deploy --config ../../wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@loomwiki/schema": "workspace:*",
    "@loomwiki/shared": "workspace:*",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.18",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.92.0"
  }
}
