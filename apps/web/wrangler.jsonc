// SPDX-License-Identifier: Apache-2.0
//
// Cloudflare Workers deploy config for `@loomwiki/web` (Astro SSR).
//
// @astrojs/cloudflare v13 dropped Cloudflare Pages support; the web
// app now deploys as a Worker. `main` is the adapter's server
// entrypoint; `assets` serves the static build output and binds the
// asset fetcher. The adapter also reads this file in dev (via
// `configPath` in astro.config.mjs) so the runtime matches prod.
//
// Single-domain deployment pattern (DEPLOY.md §dogfood): the web
// Worker serves `loomwiki.cortech.online/*`; the API worker
// (`loomwiki-api`) handles `/api/*`. The SSR pages call `/api/me`
// etc. server-side; a same-host fetch can loop back into the web
// Worker instead of reaching the API worker, so we use a Worker →
// Worker service binding instead.
//
// Fix: the `API` service binding. The SSR helper
// (`apps/web/src/lib/ssr-api.ts`) prefers `env.API.fetch(...)` over
// the bare-fetch fallback, which lands the request directly in the
// API worker without traversing DNS or the edge.
//
// Operator alternative: declaring the binding via the Cloudflare
// dashboard has the same effect at runtime. This file is the
// source-controlled way to keep the binding alongside the code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loomwiki-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "services": [
    // Bind the API worker so SSR can invoke it without going through
    // the public edge (avoids the same-host loopback gotcha).
    // Variable name `API` matches the lookup in ssr-api.ts.
    { "binding": "API", "service": "loomwiki-api" }
  ]
}
