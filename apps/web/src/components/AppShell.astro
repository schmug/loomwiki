---
// SPDX-License-Identifier: Apache-2.0

// Server-rendered three-column shell. The header is a React island
// (theme toggle + mobile menu); the sidebar + main + right-rail slots
// take Astro children, which lets each surface choose its own
// hydration directive (client:idle for the sidebar, client:load for
// the active main surface).
//
// The chrome shows two top-level destinations: Chat (room list, /)
// and Wiki (page tree, /w). Each is server-rendered <a> so the page
// is a real navigation, which keeps the WS connection lifecycle
// simple (chat opens a new socket per visit) and matches Astro's MPA
// model.
//
// Mobile-sidebar visibility is driven by `<html data-sidebar-open>` —
// AppShellHeader sets the attribute, this CSS reacts to it. Stays
// server-rendered + a single inline-style block so the chrome itself
// has no JS dependency.

import { AppShellHeader } from "@/components/AppShellHeader";
import { InboxBadge } from "@/components/inbox/InboxBadge";

interface Props {
  workspaceName: string;
  userDisplayName: string;
  /** When true, renders the Settings tab. Owner-only by convention; the
   *  Astro pages enforce the gate server-side, this prop drives the
   *  cosmetic visibility of the link. */
  isOwner?: boolean;
}

const { workspaceName, userDisplayName, isOwner = false } = Astro.props;
const hasRightRail = Astro.slots.has("right-rail");
const pathname = new URL(Astro.request.url).pathname;
const onWiki = pathname.startsWith("/w");
const onAsk = pathname.startsWith("/ask");
const onInbox = pathname.startsWith("/inbox");
const onSettings = pathname.startsWith("/settings");
const onChat = !onWiki && !onAsk && !onInbox && !onSettings;
---

<style>
  /* Mobile: hide sidebar by default; reveal when AppShellHeader marks
     the html element open. md+ always visible via Tailwind in markup. */
  @media (max-width: 767px) {
    [data-sidebar-open="true"] aside[data-app-sidebar] {
      display: block;
    }
    [data-sidebar-open="false"] aside[data-app-sidebar] {
      display: none;
    }
  }
</style>

<div class="flex h-dvh flex-col bg-background text-foreground">
  <AppShellHeader
    client:load
    workspaceName={workspaceName}
    userDisplayName={userDisplayName}
  />

  <div class="flex min-h-0 flex-1">
    <aside
      data-app-sidebar
      aria-label="Sidebar"
      class="hidden w-64 shrink-0 border-r border-border bg-secondary md:block"
    >
      <nav aria-label="Workspace nav" class="flex border-b border-border">
        <a
          href="/"
          class:list={[
            "flex-1 px-3 py-2 text-center text-sm font-medium transition-colors",
            onChat
              ? "bg-background text-foreground"
              : "text-muted-foreground hover:bg-background/60",
          ]}
          aria-current={onChat ? "page" : undefined}>Chat</a
        >
        <a
          href="/w"
          class:list={[
            "flex-1 px-3 py-2 text-center text-sm font-medium transition-colors",
            onWiki
              ? "bg-background text-foreground"
              : "text-muted-foreground hover:bg-background/60",
          ]}
          aria-current={onWiki ? "page" : undefined}>Wiki</a
        >
        <a
          href="/ask"
          class:list={[
            "flex-1 px-3 py-2 text-center text-sm font-medium transition-colors",
            onAsk
              ? "bg-background text-foreground"
              : "text-muted-foreground hover:bg-background/60",
          ]}
          aria-current={onAsk ? "page" : undefined}>Ask</a
        >
        <a
          href="/inbox"
          class:list={[
            "flex flex-1 items-center justify-center gap-1 px-3 py-2 text-center text-sm font-medium transition-colors",
            onInbox
              ? "bg-background text-foreground"
              : "text-muted-foreground hover:bg-background/60",
          ]}
          aria-current={onInbox ? "page" : undefined}
        >
          <span>Inbox</span>
          <InboxBadge client:idle />
        </a>
        {
          isOwner && (
            <a
              href="/settings"
              class:list={[
                "flex flex-1 items-center justify-center gap-1 px-3 py-2 text-center text-sm font-medium transition-colors",
                onSettings
                  ? "bg-background text-foreground"
                  : "text-muted-foreground hover:bg-background/60",
              ]}
              aria-current={onSettings ? "page" : undefined}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-3.5"
                aria-hidden="true"
              >
                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              <span>Settings</span>
            </a>
          )
        }
      </nav>
      <slot name="sidebar" />
    </aside>

    <main class="min-h-0 flex-1 overflow-hidden bg-background">
      <slot name="main" />
    </main>

    {
      hasRightRail && (
        <aside
          aria-label="Context"
          class="hidden w-72 shrink-0 border-l border-border bg-background lg:block"
        >
          <slot name="right-rail" />
        </aside>
      )
    }
  </div>
</div>
