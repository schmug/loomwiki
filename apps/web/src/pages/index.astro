---
// SPDX-License-Identifier: Apache-2.0
// Workspace home. Server-fetches /api/me. If signed in, mounts the
// AppShell with RoomList and an empty-state main pane. If 401,
// redirects to login.

import AppShell from "@/components/AppShell.astro";
import { RoomList } from "@/components/RoomList";
import Layout from "@/layouts/Layout.astro";
import { SsrAuthRequiredError, ssrApiGet } from "@/lib/ssr-api";
import type { CurrentUserPayload } from "@/lib/types";

const env = Astro.locals.runtime?.env;
let me: CurrentUserPayload;
try {
  me = await ssrApiGet<CurrentUserPayload>(Astro.request, "/api/me", env);
} catch (err) {
  if (err instanceof SsrAuthRequiredError) {
    return Astro.redirect("/login");
  }
  throw err;
}

const isOwner = me.workspace.owner_id === me.user.id;
---

<Layout title={`Loomwiki — ${me.workspace.name}`}>
  <AppShell workspaceName={me.workspace.name} userDisplayName={me.user.display_name} isOwner={isOwner}>
    <RoomList
      slot="sidebar"
      client:idle
      workspaceId={me.workspace.id}
      rooms={me.rooms}
    />
    <div slot="main" class="grid h-full place-items-center p-8 text-center">
      <div class="space-y-3">
        <h1 class="text-2xl font-semibold">Welcome to {me.workspace.name}</h1>
        <p class="text-muted-foreground">
          {
            me.rooms.length === 0
              ? "No rooms yet. Create one from the sidebar to get started."
              : "Pick a room from the sidebar to start chatting."
          }
        </p>
      </div>
    </div>
  </AppShell>
</Layout>
