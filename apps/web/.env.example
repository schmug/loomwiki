# Loomwiki web — local dev env
# Copy to .env.local and edit. .env.local is gitignored.

# When set, the web client attaches X-Local-Dev-Email on every API call.
# The worker's authMiddleware will only honor it when the triple-gate
# passes (NODE_ENV != production, ALLOW_LOCAL_DEV_AUTH=true in .dev.vars,
# request from 127.0.0.1). Anything else: header ignored.
#
# Use distinct emails across browser tabs to simulate multiple users.
PUBLIC_LOOMWIKI_DEV_EMAIL=cory@example.com
