{
  "name": "loomwiki",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare-native team workspace where chat is the input and a git-backed wiki is the output.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n worker,web -c blue,magenta \"pnpm --filter @loomwiki/worker dev\" \"pnpm --filter @loomwiki/web dev\"",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run build",
    "test": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run test",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "deploy:worker": "pnpm --filter @loomwiki/worker run deploy",
    "deploy:web": "pnpm --filter @loomwiki/web run deploy",
    "deploy:all": "pnpm --filter @loomwiki/worker run deploy && pnpm --filter @loomwiki/web run deploy",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "smoke:m2": "tsx scripts/smoke-m2.ts",
    "migrate:local": "pnpm --filter @loomwiki/worker exec wrangler d1 migrations apply loomwiki --local --config ../../wrangler.jsonc",
    "migrate:remote": "pnpm --filter @loomwiki/worker exec wrangler d1 migrations apply loomwiki --remote --config ../../wrangler.jsonc",
    "migrate:new": "pnpm --filter @loomwiki/worker exec wrangler d1 migrations create loomwiki --config ../../wrangler.jsonc",
    "seed": "tsx scripts/precompute-vault-template.ts",
    "build:manifest": "tsx scripts/precompute-vault-template.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/ws": "^8.5.13",
    "comment-json": "^5.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "sharp", "workerd"],
    "overrides": {
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "fast-uri@<3.1.2": ">=3.1.2",
      "devalue@<5.8.1": ">=5.8.1",
      "yaml@<2.8.3": ">=2.8.3"
    }
  }
}
